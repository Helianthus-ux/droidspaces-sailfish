# Droidspaces kernel config fragment — Pixel 1 (sailfish/marlin), MSM 3.18, cgroup v1
# Adapted from Droidspaces-OSS official required config for Linux 3.18 naming.
# Merge into m1s1_defconfig. Symbols absent in 3.18 are harmless (Kconfig ignores them).

# --- IPC mechanisms ---
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Core namespaces (essential for containers) ---
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# --- Seccomp (syscall filtering) ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Control groups (cgroup v1 on 3.18) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_NET_PRIO=y

# --- Device filesystem (Droidspaces sets up /dev) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- Overlay filesystem (volatile mode) ---
CONFIG_OVERLAY_FS=y

# --- Firmware loading (optional, --hw-access) ---
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y

# --- Network namespace isolation ---
CONFIG_NET_NS=y

# --- veth / bridge (NAT mode) ---
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y

# --- Netfilter core (3.18 uses the legacy IP_NF_* names) ---
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_CONNTRACK_IPV4=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_NF_NAT=y
CONFIG_NF_NAT_IPV4=y
CONFIG_NF_TABLES=y

# --- MASQUERADE: 3.18 name is IP_NF_TARGET_MASQUERADE ---
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# --- MSS clamping ---
CONFIG_NETFILTER_XT_TARGET_TCPMSS=y

# --- addrtype match (required for --dst-type LOCAL DNAT port forwarding) ---
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y

# --- conntrack netlink + NAT redirect ---
CONFIG_NF_CONNTRACK_NETLINK=y
CONFIG_NF_NAT_REDIRECT=y
CONFIG_IP_NF_TARGET_REDIRECT=y

# --- Policy routing ---
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# --- Android paranoid network blocks non-system UIDs from creating sockets;
#      disable it so containers can use the network. Symbol is absent on this
#      3.18 tree (its equivalent is not built); kept for parity/documentation. ---
# CONFIG_ANDROID_PARANOID_NETWORK is not set

# --- Optional: UFW / Fail2ban inside containers ---
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_STATE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y
CONFIG_NETFILTER_XT_MATCH_LIMIT=y
CONFIG_NETFILTER_XT_MATCH_OWNER=y
CONFIG_NETFILTER_XT_MATCH_PKTTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_TARGET_MARK=y

# --- LIO target core + loopback fabric (3.18 names) ---
# Lets us export a plain file on /data as a *real* SCSI disk via tcm_loop,
# so guests (fnOS storage manager) accept it as a disk. fnOS only enumerates
# block devices that have /sys/block/<dev>/device, i.e. real SCSI disks;
# loop/nbd/dm devices are ignored, and 3.18's loop driver has no
# LO_FLAGS_PARTSCAN either, so a SCSI-backed LUN is the only workable route.
CONFIG_TARGET_CORE=y
CONFIG_TCM_FILEIO=y
CONFIG_LOOPBACK_TARGET=y

# --- MD (software RAID) ---
# fnOS's storage manager always builds a single-disk md array even for the
# "Basic" pool type (same design as Synology: leaves room to grow later), so
# mdadm must be able to load md_mod. The tree ships CONFIG_MD=y but leaves
# BLK_DEV_MD unset, which makes `mdadm: Can't load kernel module md_mod`.
CONFIG_MD=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD_AUTODETECT=y
CONFIG_MD_LINEAR=y
CONFIG_MD_RAID0=y
CONFIG_MD_RAID1=y
CONFIG_MD_RAID10=y

# --- device-mapper extras (fnOS may lay thin/snapshot volumes on the pool) ---
CONFIG_DM_THIN_PROVISIONING=y
CONFIG_DM_SNAPSHOT=y

# --- Identify the build in uname -r ---
CONFIG_LOCALVERSION="-Droidspaces"
# CONFIG_LOCALVERSION_AUTO is not set
